+# followed yet (RustAudio/cpal#1285), and rodio is pinned only because its
+# master is what accepts cpal 0.18 — one alsa-sys has to serve the whole graph
+# (links = "alsa"), so the chain moves as a whole. Drop both once cpal
+# releases and rodio requires that release.
+cpal = { git = "https://github.com/RustAudio/cpal", rev = "d436a42f889472692fc9126d5b4f14586135942b" }
+rodio = { git = "https://github.com/RustAudio/rodio", rev = "c5f1e94290922fe4ee963ce6f85754ea6ba36243" }
