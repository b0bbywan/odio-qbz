+# 32-bit time64: on Debian trixie libasound writes a 16-byte struct timespec,
+# while libc::timespec stays 8 bytes on arm-unknown-linux-gnueabihf, so
+# Status::get_htstamp overruns the frame of whoever called it. alsa-sys 0.6.1
+# grew its own 16-byte timespec and alsa 0.12.1 uses it in place of libc's;
+# both are released, so qbz-audio just asks for them by version. cpal took the
+# fix on master only (RustAudio/cpal#1285) — master is already 0.19.0-dev and
+# no 0.18.x release will carry it — so cpal is pinned to a master rev. rodio
+# 0.22.2 and rodio master both still ask for cpal ^0.18, which 0.19.0 cannot
+# satisfy, and one alsa-sys has to serve the whole graph (links = "alsa"), so
+# no released rodio can sit in front of this cpal: the fork branch is rodio
+# master plus the one-line `cpal = "0.19"` bump upstream will make itself at
+# the release. Drop both once cpal 0.19 is out and rodio requires it.
+cpal = { git = "https://github.com/RustAudio/cpal", rev = "8f7e77a82cc4cdadf89b20b48e3acec44304a1e3" }
+rodio = { git = "https://github.com/b0bbywan/rodio", rev = "a29deadafa7efddb9e1e581ac80fe837d8b649f1" }
 
