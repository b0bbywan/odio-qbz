+/// Set shuffle to a target value (MPRIS `Shuffle` write) and reflect it.
+/// Same UP NEXT re-pull as `toggle_shuffle`, for the same reason.
+pub fn set_shuffle(
+    runtime: Runtime,
+    weak: slint::Weak<AppWindow>,
+    handle: tokio::runtime::Handle,
+    on: bool,
+) {
+    handle.spawn(async move {
+        if runtime.core().get_queue_state().await.shuffle == on {
+            return;
+        }
+        runtime.core().set_shuffle(on).await;
+        let _ = weak.upgrade_in_event_loop(move |w| {
+            w.global::<NowPlayingState>().set_shuffle(on);
+        });
+        refresh_sidebar(false);
+    });
+}
+
 /// Cycle the repeat mode Off -> All -> One -> Off and reflect it.
